# PostgreSQL connection (required for database-backed routes)
DATABASE_URL="postgresql://postgres:password@localhost:5432/world_organic_bazar?schema=public"

# Auth.js
AUTH_SECRET="replace-with-a-long-random-secret"
AUTH_TRUST_HOST="true"
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# The seed script creates/updates this account as Super Admin.
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="replace-with-a-strong-password"
ADMIN_NAME="World Organic Bazar Admin"

# Set true only for a development database to create clearly marked sample shipping rates.
SEED_DEMO_DATA="false"

# Optional image/video provider; upload adapters stay disabled until configured.
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# Optional email provider
EMAIL_FROM=""
EMAIL_SERVER_HOST=""
EMAIL_SERVER_PORT="587"
EMAIL_SERVER_USER=""
EMAIL_SERVER_PASSWORD=""

# Payment providers. Keep secrets server-side; configure only after merchant onboarding.
SSLCOMMERZ_STORE_ID=""
SSLCOMMERZ_STORE_PASSWORD=""
BKASH_APP_KEY=""
BKASH_APP_SECRET=""
BKASH_USERNAME=""
BKASH_PASSWORD=""
NAGAD_MERCHANT_ID=""
NAGAD_MERCHANT_PRIVATE_KEY=""
